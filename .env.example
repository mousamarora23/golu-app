# OpenAI / ChatGPT responses. Keep this server-side only.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
OPENAI_MODEL="gpt-5-mini"
OPENAI_FALLBACK_MODELS="gpt-4.1-mini,gpt-4o-mini"
OPENAI_REASONING_EFFORT="minimal"
OPENAI_MAX_OUTPUT_TOKENS="1400"

# Gemini is still supported for the existing live voice/avatar session and fallback chat.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# VITE_GEMINI_API_KEY can be used only for legacy client-only runs.
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Google Programmable Search JSON API.
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY"
GOOGLE_SEARCH_ENGINE_ID="YOUR_PROGRAMMABLE_SEARCH_ENGINE_ID"

# Spotify Web API catalog search through client credentials.
SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET"
SPOTIFY_REDIRECT_URI="http://127.0.0.1:3000/api/spotify/callback"

# Local app server.
PORT="3000"
APP_URL="http://localhost:3000"
